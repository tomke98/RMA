<?xml version="1.0" encoding="utf-8"?>
<!--
  Create-report form, shared by lost (Story 2.3) and found (Story 2.4) modes;
  CreateReportActivity branches copy and validation by EXTRA_REPORT_TYPE. Single
  scrolling column: category spinner, description field, an embedded location
  summary + "Postavi lokaciju" button (delegates to
  LocationPickerActivity.Contract), an embedded photo control (Fotografiraj /
  Odaberi iz galerije, or a thumbnail + Ukloni / Promijeni once attached), and
  one Filled primary submit button pinned at the bottom.

  IDs read by CreateReportActivity:
    - categorySpinner, categoryError
    - descriptionLayout, descriptionInput
    - locationSummary, locationError, setLocationButton
    - photoTitle (text swapped per mode by CreateReportActivity.applyModeCopy()),
      photoThumbnail, photoAttachButtons, takePhotoButton,
      pickPhotoButton, photoAttachedButtons, removePhotoButton,
      changePhotoButton, photoError
    - progress, submitButton
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityHeading="true"
            android:text="@string/prijava_izgubljeno_naslov"
            tools:targetApi="28"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/ink_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prijava_kategorija"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/ink_secondary" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/categoryError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/prijava_kategorija_obavezna"
            tools:visibility="visible" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descriptionLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/prijava_opis_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/prijava_lokacija_naslov"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/ink_secondary" />

        <TextView
            android:id="@+id/locationSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/prijava_lokacija_nije_postavljena"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ink_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setLocationButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/prijava_postavi_lokaciju" />

        <TextView
            android:id="@+id/locationError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/prijava_lokacija_obavezna"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/photoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/prijava_fotografija_naslov"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/ink_secondary" />

        <ImageView
            android:id="@+id/photoThumbnail"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface"
            android:contentDescription="@string/prijava_fotografija_opis"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/photoAttachButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/takePhotoButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/prijava_fotografiraj" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickPhotoButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/prijava_odaberi_iz_galerije" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/photoAttachedButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removePhotoButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/prijava_ukloni" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changePhotoButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/prijava_promijeni" />

        </LinearLayout>

        <TextView
            android:id="@+id/photoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/prijava_fotografija_obavezna"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/prijava_objavi" />

    </LinearLayout>

</ScrollView>
