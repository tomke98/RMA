<?xml version="1.0" encoding="utf-8"?>
<!--
  Board list row (Story 3.3): one open report, mirroring activity_report_detail's
  photo/placeholder pair plus category/type/age/distance. Whole card is clickable
  (opens ReportDetailActivity); distanceText is hidden per-row when no GPS fix is
  available, never showing a "0 m" placeholder.

  IDs read by BoardListAdapter:
    - photoImage, photoGlyphText, categoryText, typeChip, ageText, distanceText
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/photoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/photoGlyphText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/ink_secondary"
                android:visibility="gone"
                tools:text="Ključevi"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/categoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/ink_primary"
                tools:text="Ključevi" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                tools:text="@string/prijava_tip_izgubljeno" />

            <TextView
                android:id="@+id/ageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/ink_secondary"
                tools:text="prije 2 sata" />

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/ink_secondary"
                android:visibility="gone"
                tools:text="1.2 km"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
