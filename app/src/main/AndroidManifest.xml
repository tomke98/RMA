<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ lets the user grant COARSE only; declare both (AD-10 works with either). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Story 4.2: required on API 33+ for CategoryNotifier's notify() calls to
         display; no runtime prompt needed/shown below API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 24-27 companion so androidx.biometric can prompt below API 28
         (closes the Story 1.1 deferred-work item). Install-time, no runtime request. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <!-- Camera and location are used when present but must not block install. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 11+ (targetSdk 30+) package-visibility: without this,
         Intent.resolveActivity()/PackageManager queries for the camera app
         can return null even when one is installed (Story 2.2, AD-8). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.LostAndFound"
        android:usesCleartextTraffic="false">

        <!-- Google Play services' Maps "dynamite" module still references the
             legacy Apache HTTP client, removed from the default classpath on
             API 28+; without this the map crashes with NoClassDefFoundError
             on a background thread the first time it loads (emulator + real
             devices alike). Not used by our own code. -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- EntryActivity is the ONLY MAIN/LAUNCHER activity (AD-12). It owns the
             routing table and finish()es after routing. -->
        <activity
            android:name=".ui.entry.EntryActivity"
            android:exported="true"
            android:theme="@style/Theme.LostAndFound">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Routing targets. No intent filters: reached only by explicit Intent. -->
        <activity
            android:name=".ui.auth.SignInActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lock.BiometricLockActivity"
            android:exported="false" />
        <activity
            android:name=".ui.board.BoardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.report.LocationPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.report.CreateReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.detail.ReportDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.categories.FollowedCategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.reports.MyReportsActivity"
            android:exported="false" />

        <!-- Camera capture in Epic 2 writes to an app-private file exposed here (AD-8). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Maps API key injected by the secrets Gradle plugin from local.properties.
             Empty until the user sets MAPS_API_KEY; the map renders blank tiles only. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

    </application>

</manifest>
